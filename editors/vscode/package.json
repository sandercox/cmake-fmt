{
  "name": "cmake-fmt",
  "displayName": "CMake Format (cmake-fmt)",
  "description": "Stop arguing about CMake formatting. Fast, grammar-aware formatter for CMakeLists.txt and .cmake files.",
  "version": "0.10.2",
  "publisher": "paralleldimension",
  "license": "MIT",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/sandercox/cmake-fmt"
  },
  "bugs": {
    "url": "https://github.com/sandercox/cmake-fmt/issues"
  },
  "engines": {
    "vscode": "^1.105.0"
  },
  "keywords": [
    "cmake",
    "formatter",
    "code-formatting",
    "cmake-format",
    "formatting",
    "style",
    "build-system",
    "linter"
  ],
  "categories": [
    "Formatters"
  ],
  "activationEvents": [
    "onLanguage:cmake",
    "onLanguage:toml",
    "onLanguage:yaml"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "toml",
        "filenamePatterns": [
          "*.cmake-fmt.toml",
          "*.cmake-fmt.tml"
        ]
      },
      {
        "id": "yaml",
        "filenames": [
          ".cmake-fmt"
        ],
        "filenamePatterns": [
          "*.cmake-fmt.yaml",
          "*.cmake-fmt.yml"
        ]
      }
    ],
    "yamlValidation": [
      {
        "fileMatch": [
          ".cmake-fmt",
          "*.cmake-fmt.yaml",
          "*.cmake-fmt.yml"
        ],
        "url": "./schemas/cmake-fmt.schema.json"
      }
    ],
    "configuration": {
      "title": "CMake Format",
      "properties": {
        "cmakeFmt.binaryPath": {
          "type": "string",
          "default": "cmake-fmt",
          "markdownDescription": "Path to the `cmake-fmt` binary. When set to the default (`cmake-fmt`), the extension uses the bundled binary. Set an absolute path or command name to override.",
          "scope": "resource"
        },
        "cmakeFmt.enable": {
          "type": "boolean",
          "default": true,
          "description": "Enable/disable cmake-fmt formatting",
          "scope": "resource"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "cp ../../LICENSE LICENSE && cp ../../README.md README.md && npm run package",
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "package": "node esbuild.js --production",
    "lint": "eslint src --ext ts"
  },
  "devDependencies": {
    "@types/vscode": "^1.105.0",
    "@types/node": "20.x",
    "typescript": "^5.7.0",
    "esbuild": "^0.24.0",
    "@vscode/vsce": "^3.0.0"
  }
}
